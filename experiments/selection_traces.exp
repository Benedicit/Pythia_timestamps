# configurations
BASE = --warmup_instructions=100000000 --simulation_instructions=500000000
PYTHIA = --l2c_prefetcher_types=scooby --config=$(PYTHIA_HOME)/config/pythia.ini

# experiments for Figure 10(a) and Figure 8
pythia						$(BASE) $(PYTHIA)
